# Instale como /srv/precisei/runtime.env, proprietário operacional, modo 0600.
# Copie, preencha e nunca envie ao Git. Hashes devem estar entre aspas simples.
IMAGE=ghcr.io/ermandotimoteo/precisei@sha256:PREENCHA_COM_DIGEST_APROVADO
ALLOWED_IMAGE_REPOSITORY=ghcr.io/ermandotimoteo/precisei
CADDY_IMAGE=caddy@sha256:PREENCHA_COM_DIGEST
MYSQL_CLIENT_IMAGE=mysql@sha256:PREENCHA_COM_DIGEST
PUBLIC_HOST=precisei.example.invalid
APP_PORT=8080
MANAGEMENT_PORT=9090
DB_URL=jdbc:mysql://mysql-interno:3306/precisei_prod
DB_HOST=mysql-interno
DB_PORT=3306
DB_NAME=precisei_prod
DB_USERNAME=precisei_app
DB_PASSWORD=
DB_MIGRATION_USERNAME=precisei_migrator
DB_MIGRATION_PASSWORD=
DB_BACKUP_USERNAME=precisei_backup
DB_BACKUP_PASSWORD=
# Novos bancos: production. Bancos históricos já migrados: migration.
DB_SCHEMA_LINEAGE=production
ADMIN_EMAIL=
ADMIN_PASSWORD_HASH=
AGE_RECIPIENT=
BACKUP_DIR=/srv/precisei/backups
BACKUP_OFFSITE_DIR=
BACKUP_RETENTION_DAYS=7
DEPLOY_ENV=staging
OBSERVE_SECONDS=900
